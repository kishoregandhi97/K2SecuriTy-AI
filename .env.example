# Optional comma-separated exact hostnames authorized for assessments.
# A target must also be registered and marked authorized in the application.
ALLOWED_HOSTS=
REQUEST_TIMEOUT_SECONDS=8
REQUESTS_PER_SCAN=12
MAX_RESPONSE_BYTES=65536

# AI is optional. Ollama's OpenAI-compatible endpoint is a common local option.
AI_ENABLED=false
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen3:1.7b
AI_TIMEOUT_SECONDS=45

DATABASE_URL=sqlite:///./data/k2security.db
APP_ENV=local
